  "endpoint": [
    {
      "implementation_id": "main_include_task_router",
      "test_cases": [
        {
          "description": "Verify that a new task can be created successfully with valid input data.",
          "id": "TC01_create_task_success",
          "implementation_id": "main_include_task_router",
          "name": "Create Task - Success",
          "request_body_json": {
            "description": "Milk, Bread, Eggs",
            "due_date": "2024-07-01",
            "title": "Buy groceries"
          },
          "request_headers": {
            "Content-Type": "application/json"
          },
          "request_method": "POST",
          "request_url": "/tasks",
          "response_body_json": {
            "description": "Milk, Bread, Eggs",
            "due_date": "2024-07-01",
            "id": "generated_task_id",
            "status": "pending",
            "title": "Buy groceries"
          },
          "response_status_code": 201,
          "test_setup": {
            "given": "Task router is included and database is empty.",
            "then": "Task is created and returned with status 201.",
            "when": "POST request is sent with valid task data."
          },
          "type": "positive"
        },
        {
          "description": "Verify that creating a task without a title returns a validation error.",
          "id": "TC02_create_task_missing_title",
          "implementation_id": "main_include_task_router",
          "name": "Create Task - Missing Title",
          "request_body_json": {
            "description": "Do laundry",
            "due_date": "2024-07-02"
          },
          "request_headers": {
            "Content-Type": "application/json"
          },
          "request_method": "POST",
          "request_url": "/tasks",
          "response_body_json": {
            "detail": [
              {
                "loc": [
                  "body",
                  "title"
                ],
                "msg": "field required",
                "type": "value_error.missing"
              }
            ]
          },
          "response_status_code": 422,
          "test_setup": {
            "given": "Task router is included.",
            "then": "Validation error is returned with status 422.",
            "when": "POST request is sent without 'title' field."
          },
          "type": "negative"
        },
        {
          "description": "Verify that creating a task with an empty title returns a validation error.",
          "id": "TC03_create_task_empty_title",
          "implementation_id": "main_include_task_router",
          "name": "Create Task - Empty Title",
          "request_body_json": {
            "description": "Workout",
            "due_date": "2024-07-03",
            "title": ""
          },
          "request_headers": {
            "Content-Type": "application/json"
          },
          "request_method": "POST",
          "request_url": "/tasks",
          "response_body_json": {
            "detail": [
              {
                "loc": [
                  "body",
                  "title"
                ],
                "msg": "Title must not be empty",
                "type": "value_error"
              }
            ]
          },
          "response_status_code": 422,
          "test_setup": {
            "given": "Task router is included.",
            "then": "Validation error is returned with status 422.",
            "when": "POST request is sent with empty 'title'."
          },
          "type": "edge"
        },
        {
          "description": "Verify that creating a task with a maximum allowed title length is successful.",
