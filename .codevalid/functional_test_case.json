        {
          "description": "Verify that a new task is successfully added with valid data, and that it receives a unique ID, is persisted, and returned.",
          "id": "add_task_valid_input",
          "implementation_id": "task_repository_add_task",
          "name": "Add Task with Valid Input",
          "test_setup": {
            "given": {
              "id_counter": 1,
              "initial_task_list": [],
              "json_file_state": [],
              "task_data": {
                "description": "Write final docs",
                "due_date": "2024-06-30",
                "priority": 3,
                "title": "Complete project documentation"
              }
            },
            "then": {
              "created_task": {
                "description": "Write final docs",
                "due_date": "2024-06-30",
                "id": 1,
                "priority": 3,
                "title": "Complete project documentation"
              },
              "id_counter": 2,
              "json_file_state": [
                {
                  "description": "Write final docs",
                  "due_date": "2024-06-30",
                  "id": 1,
                  "priority": 3,
                  "title": "Complete project documentation"
                }
              ],
              "log": "Task created with ID 1",
              "task_list": [
                {
                  "description": "Write final docs",
                  "due_date": "2024-06-30",
                  "id": 1,
                  "priority": 3,
                  "title": "Complete project documentation"
                }
              ]
            },
            "when": "TaskRepository.add_task is called with task_data"
          },
          "type": "positive"
        },
        {
          "description": "Verify that the function handles missing required fields by raising an error or returning a validation message.",
          "id": "add_task_missing_required_field",
          "implementation_id": "task_repository_add_task",
          "name": "Add Task Missing Required Field",
          "test_setup": {
            "given": {
              "id_counter": 1,
              "initial_task_list": [],
              "json_file_state": [],
              "task_data": {
                "description": "No title provided",
                "due_date": "2024-06-30",
                "priority": 2
              }
            },
            "then": {
              "created_task": null,
              "error": "Missing required field: title",
              "id_counter": 1,
              "json_file_state": [],
              "log": "Task creation failed: missing required field",
              "task_list": []
            },
            "when": "TaskRepository.add_task is called with task_data missing 'title'"
          },
          "type": "negative"
        },
        {
          "description": "Verify behavior when empty input is provided.",
          "id": "add_task_empty_input",
          "implementation_id": "task_repository_add_task",
          "name": "Add Task with Empty Input",
          "test_setup": {
            "given": {
              "id_counter": 1,
              "initial_task_list": [],
