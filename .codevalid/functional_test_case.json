              "error": "Input data is empty",
              "id_counter": 1,
              "json_file_state": [],
              "log": "Task creation failed: input empty",
              "task_list": []
            },
            "when": "TaskRepository.add_task is called with empty task_data"
          },
          "type": "negative"
        },
        {
