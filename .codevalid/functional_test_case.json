                {
                  "description": "First instance",
                  "due_date": "2024-07-01",
                  "id": 2,
                  "priority": 1,
                  "title": "Duplicate Task"
                }
              ],
              "log": "Task created with ID 2",
              "task_list": [
                {
                  "description": "Existing instance",
                  "due_date": "2024-06-22",
                  "id": 1,
                  "priority": 2,
                  "title": "Duplicate Task"
                },
                {
                  "description": "First instance",
                  "due_date": "2024-07-01",
